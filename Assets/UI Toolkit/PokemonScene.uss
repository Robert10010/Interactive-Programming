/* Extra styles for the Pokémon scene, used together with EnvCustomization.uss */

/* Only one panel, on the right; the rest of the screen shows the scene */
.pokemon-screen {
    justify-content: flex-end;
    padding: 30px;
}

.pokemon-panel {
    width: 640px;
    max-height: 100%;
}

.panel-scroll {
    flex-shrink: 1;
}

.search-row {
    flex-direction: row;
    align-items: center;
}

.search-field {
    flex-grow: 1;
    font-size: 30px;
    margin: 4px 0;
}

.search-button {
    width: 120px;
    height: 56px;
    margin: 4px;
    font-size: 30px;
}

.pokemon-row,
.card-row {
    flex-direction: row;
    margin-top: 8px;
}

.sprite-image {
    width: 160px;
    height: 160px;
    margin-right: 14px;
    flex-shrink: 0;
    background-color: rgba(255, 255, 255, 0.5);
    -unity-background-scale-mode: scale-to-fit;
    border-top-left-radius: 80px;
    border-top-right-radius: 80px;
    border-bottom-right-radius: 80px;
    border-bottom-left-radius: 80px;
}

/* Trading cards are 63 x 88 mm */
.card-image {
    width: 252px;
    height: 352px;
    margin-right: 14px;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0.12);
    -unity-background-scale-mode: scale-to-fit;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
}

.pokemon-info {
    flex-grow: 1;
    flex-shrink: 1;
}

.pokemon-name {
    font-size: 40px;
    -unity-font-style: bold;
    white-space: normal;
}

.section-title {
    font-size: 40px;
    margin-top: 16px;
}

.card-name {
    -unity-font-style: bold;
}

.price-label {
    font-size: 36px;
    color: rgb(150, 60, 20);
    margin-top: 10px;
}

.mood-label {
    font-size: 34px;
    margin-top: 10px;
}
