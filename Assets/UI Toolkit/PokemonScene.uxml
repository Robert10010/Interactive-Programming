<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/EnvCustomization.uss?fileID=7433441132597879392&amp;guid=7763bc65b2c588c44a47ef4be92b6426&amp;type=3#EnvCustomization"/>
    <Style src="/Assets/UI Toolkit/PokemonScene.uss"/>
    <ui:VisualElement name="FullScreen" class="full-screen">
        <ui:VisualElement name="ControllPanel" class="control-panel">
            <ui:VisualElement name="EnvSetting" class="section env-setting">
                <ui:Label text="EnvSetting" name="EnvSettingTitle" class="subtilte"/>
                <ui:ScrollView name="ScrollView" class="toggle-list">
                    <ui:Toggle label="Rock" name="Rock" value="true" class="Toggle">
                        <Bindings>
                            <ui:DataBinding property="value" data-source-path="Rock" binding-mode="TwoWay"/>
                        </Bindings>
                    </ui:Toggle>
                    <ui:Toggle label="Grass" name="Grass" value="true" class="Toggle">
                        <Bindings>
                            <ui:DataBinding property="value" data-source-path="Grass" binding-mode="TwoWay"/>
                        </Bindings>
                    </ui:Toggle>
                    <ui:Toggle label="Flower" name="flower" value="true" class="Toggle">
                        <Bindings>
                            <ui:DataBinding property="value" data-source-path="Flower" binding-mode="TwoWay"/>
                        </Bindings>
                    </ui:Toggle>
                    <ui:Toggle label="Camp Fire" name="CampFire" value="true" class="Toggle">
                        <Bindings>
                            <ui:DataBinding property="value" data-source-path="CampFire" binding-mode="TwoWay"/>
                        </Bindings>
                    </ui:Toggle>
                    <ui:Toggle label="Fence" name="Fence" value="true" class="Toggle">
                        <Bindings>
                            <ui:DataBinding property="value" data-source-path="Fence" binding-mode="TwoWay"/>
                        </Bindings>
                    </ui:Toggle>
                    <ui:Toggle label="Plant" name="Plant" value="true" class="Toggle">
                        <Bindings>
                            <ui:DataBinding property="value" data-source-path="Plant" binding-mode="TwoWay"/>
                        </Bindings>
                    </ui:Toggle>
                    <ui:Toggle label="Wood" name="Wood" value="true" class="Toggle">
                        <Bindings>
                            <ui:DataBinding property="value" data-source-path="Wood" binding-mode="TwoWay"/>
                        </Bindings>
                    </ui:Toggle>
                </ui:ScrollView>
                <ui:Slider label="Fire Size" value="1" low-value="0" high-value="5" name="FireSizeSlider" class="env-slider">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="FireSize" binding-mode="TwoWay"/>
                    </Bindings>
                </ui:Slider>
                <ui:Slider label="Fire Intensity" value="1" low-value="0" high-value="5" name="FireIntensitySlider" class="env-slider">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="FireIntensity" binding-mode="TwoWay"/>
                    </Bindings>
                </ui:Slider>
                <ui:Slider label="Sun Intensity" value="0.78" low-value="0" high-value="2" name="SunIntensitySlider" class="env-slider">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="SunIntensity" binding-mode="TwoWay"/>
                    </Bindings>
                </ui:Slider>
                <ui:Slider label="Sun Rotation" value="18.5" low-value="0" high-value="360" name="SunRotationSlider" class="env-slider">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="SunRotation" binding-mode="TwoWay"/>
                    </Bindings>
                </ui:Slider>
            </ui:VisualElement>
            <ui:VisualElement name="Atomosphere" class="section atmosphere">
                <ui:Label text="Atomosphere" name="AtmosphereTitle" class="subtilte"/>
                <ui:DropdownField label="Env Theme" name="SkyThemeDropdown" choices="Day,Sunset,Night" class="env-dropdown">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="SkyTheme" binding-mode="TwoWay"/>
                    </Bindings>
                </ui:DropdownField>
                <ui:TextField label="File" value="Environment.json" name="FileNameTextField" class="env-dropdown"/>
                <ui:VisualElement name="FileButtonRow" class="button-row file-row">
                    <ui:Button text="Save" name="SaveBtn" class="file-button"/>
                    <ui:Button text="Load" name="LoadBtn" class="file-button"/>
                    <ui:Button text="Apply" name="ApplyBtn" class="file-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="SceneArea" class="scene-area">
            <ui:VisualElement name="InfoPanel" class="info-panel pokemon-panel">
                <ui:Label text="Pokemon Camp" name="InfoTitle" class="info-title"/>
                <ui:VisualElement name="SearchRow" class="search-row">
                    <ui:TextField name="SearchField" value="pikachu" class="search-field"/>
                    <ui:Button text="Search" name="SearchButton" class="search-button"/>
                    <ui:Button text="Random" name="RandomButton" class="search-button"/>
                </ui:VisualElement>
                <ui:VisualElement name="PokemonRow" class="pokemon-row">
                    <ui:VisualElement name="SpriteImage" class="sprite-image"/>
                    <ui:VisualElement name="PokemonInfo" class="pokemon-info">
                        <ui:Label text="-" name="NameLabel" class="pokemon-name"/>
                        <ui:Label text="Type: -" name="TypeLabel" class="info-label"/>
                        <ui:Label text="Height: -" name="HeightLabel" class="info-label"/>
                        <ui:Label text="Weight: -" name="WeightLabel" class="info-label"/>
                        <ui:Label text="Speed: -" name="SpeedLabel" class="info-label"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="Waiting for data..." name="InfoLabel" class="info-label info-status"/>
                <ui:Toggle label="Pokemon drives scene" name="UsePokemonToggle" value="true" class="info-field"/>
            </ui:VisualElement>
            <ui:VisualElement name="ButtonPanel" class="button-panel">
                <ui:Button text="Forward" name="ForwardButton" class="cam-button"/>
                <ui:VisualElement name="ButtonRow" class="button-row">
                    <ui:Button text="Left" name="LeftButton" class="cam-button"/>
                    <ui:Button text="Right" name="RightButton" class="cam-button"/>
                </ui:VisualElement>
                <ui:Button text="Backward" name="BackwardButton" class="cam-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
