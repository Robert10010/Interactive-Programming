<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/EnvCustomization.uss?fileID=7433441132597879392&amp;guid=7763bc65b2c588c44a47ef4be92b6426&amp;type=3#EnvCustomization"/>
    <Style src="/Assets/UI Toolkit/PokemonScene.uss"/>
    <ui:VisualElement name="FullScreen" class="full-screen pokemon-screen">
        <ui:VisualElement name="InfoPanel" class="info-panel pokemon-panel">
            <ui:ScrollView name="PanelScroll" class="panel-scroll">
                <ui:Label text="Pokemon Camp" name="InfoTitle" class="info-title"/>
                <ui:VisualElement name="SearchRow" class="search-row">
                    <ui:TextField name="SearchField" value="pikachu" class="search-field"/>
                    <ui:Button text="Search" name="SearchButton" class="search-button"/>
                    <ui:Button text="Random" name="RandomButton" class="search-button"/>
                </ui:VisualElement>
                <ui:VisualElement name="PokemonRow" class="pokemon-row">
                    <ui:VisualElement name="SpriteImage" class="sprite-image"/>
                    <ui:VisualElement name="PokemonInfo" class="pokemon-info">
                        <ui:Label text="-" name="NameLabel" class="pokemon-name"/>
                        <ui:Label text="Type: -" name="TypeLabel" class="info-label"/>
                        <ui:Label text="Height: -" name="HeightLabel" class="info-label"/>
                        <ui:Label text="Weight: -" name="WeightLabel" class="info-label"/>
                        <ui:Label text="Speed: -" name="SpeedLabel" class="info-label"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="Trading Card" name="CardTitle" class="section-title"/>
                <ui:DropdownField label="Card" name="CardDropdown" class="info-field"/>
                <ui:VisualElement name="CardRow" class="card-row">
                    <ui:VisualElement name="CardImage" class="card-image"/>
                    <ui:VisualElement name="CardInfo" class="pokemon-info">
                        <ui:Label text="-" name="CardNameLabel" class="info-label card-name"/>
                        <ui:Label text="Rarity: -" name="RarityLabel" class="info-label"/>
                        <ui:Label text="Market price: -" name="PriceLabel" class="info-label price-label"/>
                        <ui:Label text="Mood: -" name="MoodLabel" class="info-label mood-label"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="Waiting for data..." name="InfoLabel" class="info-label info-status"/>
                <ui:Toggle label="Pokemon drives scene" name="UsePokemonToggle" value="true" class="info-field"/>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
