:root {
    -unity-font-definition: url("project://database/Assets/font/Silver.ttf?fileID=12800000\&guid=a56e52fe48afdd641bf405a0f934cac6\&type=3#Silver");
}

.full-screen {
    flex-grow: 1;
    flex-direction: row;
}

.control-panel {
    width: 32%;
    flex-direction: column;
    margin: 30px;
    padding: 40px;
    background-color: rgba(255, 255, 255, 0.69);
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
}

.section {
    flex-direction: column;
}

/* EnvSetting takes the remaining height; Atomosphere keeps its own size at the bottom */
.env-setting {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.atmosphere {
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 20px;
}

.subtilte {
    font-size: 70px;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

/* The toggle list scrolls instead of pushing the sliders out of the panel */
.toggle-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 10px 20px;
}

.Toggle {
    font-size: 50px;
    -unity-font-definition: url("project://database/Assets/font/Silver.ttf?fileID=12800000\&guid=a56e52fe48afdd641bf405a0f934cac6\&type=3#Silver");
}

.env-slider,
.env-dropdown {
    font-size: 40px;
    margin-top: 6px;
}

.env-slider .unity-base-field__label,
.env-dropdown .unity-base-field__label {
    min-width: 260px;
}

.scene-area {
    flex-grow: 1;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
    padding: 30px;
}

.info-panel {
    width: 520px;
    padding: 20px 30px;
    background-color: rgba(255, 255, 255, 0.69);
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 30px;
}

.info-title {
    font-size: 48px;
    margin-bottom: 6px;
}

.info-label {
    font-size: 32px;
    white-space: normal;
}

.info-status {
    font-size: 26px;
    color: rgb(60, 60, 60);
    margin-top: 6px;
}

.info-field {
    font-size: 30px;
}

.info-field .unity-base-field__label {
    min-width: 200px;
}

.file-row {
    margin-top: 10px;
    justify-content: space-between;
}

.file-button {
    flex-grow: 1;
    height: 60px;
    margin: 4px;
    font-size: 32px;
}

.button-panel {
    flex-direction: column;
    align-items: center;
}

.button-row {
    flex-direction: row;
}

.cam-button {
    width: 160px;
    height: 80px;
    margin: 6px;
    font-size: 36px;
}
